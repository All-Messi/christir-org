<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>2 John on Christian Internet Resources</title><link>https://christir.org/translations/cnt-nt/2-john/</link><description>Recent content in 2 John on Christian Internet Resources</description><generator>Hugo</generator><language>en-us</language><atom:link href="https://christir.org/translations/cnt-nt/2-john/index.xml" rel="self" type="application/rss+xml"/><item><title>2 John 1</title><link>https://christir.org/translations/cnt-nt/2-john/chapter-01/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://christir.org/translations/cnt-nt/2-john/chapter-01/</guid><description>&lt;h1 id="2-john-chapter-1" class="chapter-h1">2 John Chapter 1&lt;span class="visually-hidden">, Conversational New Testament&lt;/span>&lt;/h1>&lt;h3 id="salutation">Salutation&lt;/h3>&lt;p class="MsoNormal" style='margin-bottom:0in;'>&lt;b>&lt;span style='font-size:12.0pt;line-height:115%;font-family:"Times New Roman",serif'>            &lt;/span>&lt;/b>&lt;span class="verse verse-v1" id="v1">&lt;sup class="verse-num">1&lt;/sup> &lt;span style='font-size:12.0pt;line-height:115%;font-family:"Times New Roman",serif'>The Elder to the elect lady and her children that&lt;sup>pl&lt;/sup> I really love—as does everybody that knows the truth—&lt;/span>&lt;/span>
&lt;span class="verse verse-v2" id="v2">&lt;sup class="verse-num">2&lt;/sup> &lt;span style='font-size:12.0pt;line-height:115%;font-family:"Times New Roman",serif'>because of the truth that’s in us and with us forever. &lt;/span>&lt;/span>
&lt;span class="verse verse-v3" id="v3">&lt;sup class="verse-num">3&lt;/sup> &lt;span style='font-size:12.0pt;line-height:115%;font-family:"Times New Roman",serif'>We’ll have grace, mercy, and peace from God the Father and Jesus Christ&lt;sup>Messiah&lt;/sup>, the Son of the Father in truth and love.                                                                                                                                      &lt;/span>&lt;b>&lt;span style='font-size:10.0pt;line-height:115%;font-family:"Times New Roman",serif'>2 Jn 1-3&lt;/span>&lt;/b>&lt;/span>&lt;/p></description></item></channel></rss>