<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>3 John on Christian Internet Resources</title><link>https://christir.org/translations/cnt-nt/3-john/</link><description>Recent content in 3 John on Christian Internet Resources</description><generator>Hugo</generator><language>en-us</language><atom:link href="https://christir.org/translations/cnt-nt/3-john/index.xml" rel="self" type="application/rss+xml"/><item><title>3 John 1</title><link>https://christir.org/translations/cnt-nt/3-john/chapter-01/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://christir.org/translations/cnt-nt/3-john/chapter-01/</guid><description>&lt;h1 id="3-john-chapter-1" class="chapter-h1">3 John Chapter 1&lt;span class="visually-hidden">, Conversational New Testament&lt;/span>&lt;/h1>&lt;h3 id="salutation">Salutation&lt;/h3>&lt;p class="MsoNormal" style='margin-bottom:0in;'>&lt;span style='font-size:12.0pt;line-height:115%;font-family:"Times New Roman",serif'>            &lt;/span>&lt;span class="verse verse-v1" id="v1">&lt;sup class="verse-num">1&lt;/sup> &lt;span style='font-size:12.0pt;line-height:115%;font-family:"Times New Roman",serif'>The Elder to Gaius, that I truly love.&lt;/span>&lt;/span>&lt;/p>
&lt;p class="MsoNormal" style='margin-bottom:0in;'>&lt;span class="verse verse-v2" id="v2">&lt;sup class="verse-num">2&lt;/sup> &lt;span style='font-size:12.0pt;line-height:115%;font-family:"Times New Roman",serif'>I pray that you’ll be as prosperous and healthy in every way as you are in your soul. &lt;/span>&lt;/span>
&lt;span class="verse verse-v3" id="v3">&lt;sup class="verse-num">3&lt;/sup> &lt;span style='font-size:12.0pt; line-height:115%;font-family:"Times New Roman",serif'>I was so happy when the brothers reported that you really live by the truth. &lt;/span>&lt;/span>
&lt;span class="verse verse-v4" id="v4">&lt;sup class="verse-num">4&lt;/sup> &lt;span style='font-size:12.0pt;line-height:115%;font-family:"Times New Roman",serif'>Nothing makes me happier than hearing that my children are doing that. &lt;/span>&lt;/span>&lt;/p></description></item></channel></rss>